#!/bin/bash
# 像素放置 · PixelIdle — 生命周期脚本（start / stop / status）
# 通过统一网关提供访问：Node 服务监听 target/app.sock

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

APP_DIR="${TRIM_APPDEST:-/var/apps/PixelIdle/target}"
SOCKET_PATH="${APP_DIR}/app.sock"
GATEWAY_PREFIX="/app/PixelIdle"

# 使用 nodejs_v22 依赖应用提供的运行时
NODE_BIN="/var/apps/nodejs_v22/target/bin/node"

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
  local pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

status_app() {
  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    if check_process "$pid"; then
      return 0
    fi
    rm -f "${PID_FILE}"
  fi
  return 1
}

start_app() {
  if status_app; then
    log_msg "already running"
    return 0
  fi

  if [ ! -x "${NODE_BIN}" ]; then
    # 回退到 PATH 中的 node
    NODE_BIN="$(command -v node 2>/dev/null || true)"
  fi
  if [ -z "${NODE_BIN}" ] || [ ! -x "${NODE_BIN}" ]; then
    echo "未找到 Node.js 运行时，请确认依赖应用 nodejs_v22 已安装。" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    return 1
  fi

  mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

  log_msg "Starting PixelIdle (node=${NODE_BIN})"
  cd "${APP_DIR}/server" || return 1

  SOCKET_PATH="${SOCKET_PATH}" \
  GATEWAY_PREFIX="${GATEWAY_PREFIX}" \
  TRIM_APPDEST="${APP_DIR}" \
  TRIM_PKGVAR="${TRIM_PKGVAR:-${APP_DIR}/data}" \
  TRIM_APPNAME="${TRIM_APPNAME:-PixelIdle}" \
  NODE_ENV=production \
  "${NODE_BIN}" server.js >> "${LOG_FILE}" 2>&1 &

  local pid=$!
  echo "${pid}" > "${PID_FILE}"

  # 等待 socket 就绪（最多 10 秒）
  local i=0
  while [ $i -lt 20 ]; do
    if [ -S "${SOCKET_PATH}" ]; then
      log_msg "socket ready: ${SOCKET_PATH}"
      return 0
    fi
    sleep 0.5
    i=$((i + 1))
  done

  # 进程还在但 socket 未出现，仍视为启动中
  if check_process "${pid}"; then
    log_msg "process running but socket not detected yet"
    return 0
  fi

  echo "应用启动失败，请查看日志：${LOG_FILE}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
  return 1
}

stop_app() {
  log_msg "Stopping PixelIdle"

  if [ -f "${PID_FILE}" ]; then
    local pid
    pid="$(head -n 1 "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    if check_process "$pid"; then
      kill -TERM "$pid" 2>>"${LOG_FILE}" || true
      local count=0
      while check_process "$pid" && [ $count -lt 15 ]; do
        sleep 1
        count=$((count + 1))
      done
      if check_process "$pid"; then
        kill -KILL "$pid" 2>>"${LOG_FILE}" || true
      fi
    fi
    rm -f "${PID_FILE}"
  fi

  rm -f "${SOCKET_PATH}"
  return 0
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    exit 1
    ;;
esac
